# Секреты панели. Скопировать в /etc/vpn-web.env (chmod 600) и заполнить.
# В git этот файл НЕ коммитить с реальными значениями.

# --- Т-Банк (эквайринг) ---
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_TAXATION=usn_income

# --- Секрет для /pay/renew ---
RENEW_SECRET=

# --- Юридические данные (ИП) ---
LEGAL_NAME=
LEGAL_INN=
LEGAL_OGRNIP=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=

# --- Telegram-бот ---
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
